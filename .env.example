# Edge Trader for Schwab: copy this file to .env and fill in your own Schwab app details.
# .env is never committed. Get the values at https://developer.schwab.com (Dashboard, your app).

# Your app's App Key and Secret
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the Callback URL registered on your Schwab app exactly
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Optional: where the Schwab tokens are kept (default ~/.schwabdev/tokens.db)
# SCHWAB_TOKENS_DB=
# Optional: read the keys from another app's .env instead (to share one Schwab login)
# SCHWAB_ENV_FILE=
# Optional: the local port (default 8770)
# COMPANION_PORT=8770
# Optional: set to 1 to turn off the once-a-day check for a newer release on GitHub
# EDGE_TRADER_NO_UPDATE_CHECK=
# Optional: set to 1 to turn off the order status reads about 0.3 s and 1 s after a new entry is sent
# EDGE_TRADER_NO_EARLY_STATUS=
# Optional: Schwab's quote stream (companion/quote_stream.py). shadow (default): runs beside the REST
# quotes call and is only compared, once a minute, in data/netlog/. on: the marks come from the stream
# while it is live and covers every symbol. off: no stream.
# EDGE_TRADER_QUOTE_STREAM=shadow
# Optional: set to 0 to read the account and order list in the main poller loop again, instead of
# on their own Schwab connection and thread (the order lane, 2026-11-23)
# EDGE_TRADER_ORDER_LANE=
